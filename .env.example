# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name (defaults to "portfolio")
MONGODB_DB=portfolio

# Any long random string; used to hash visitor IPs for rate limiting
IP_HASH_SALT=change-me-to-a-long-random-string

# Visitor chess: secret salt for hashing visitor IDs and IPs (required in production)
CHESS_HASH_SALT=change-me-to-another-long-random-string
# Visitor chess: cooldown between moves per visitor/IP in milliseconds (24h = 86400000)
CHESS_MOVE_COOLDOWN_MS=86400000

# Optional: email notifications for new contact messages via Resend
# CONTACT_FROM_EMAIL must use a domain verified in Resend (e.g. carlsdaleescalo.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Portfolio <noreply@carlsdaleescalo.com>"
